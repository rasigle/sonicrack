{
  "metadata": {
    "name": "Demo: Wobble Bass",
    "author": "SonicRack",
    "description": "Dubstep-style wobble bass. Fat sawtooth into a high-resonance low-pass filter, cutoff swept by a unipolar LFO, then soft distortion grit.",
    "tags": ["demo", "bass", "wobble", "dubstep", "filter"],
    "category": "Demo",
    "created": "2026-07-30T12:00:00",
    "version": "1.0"
  },
